{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "sdk-57"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "sdk-57"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "sdk-57"
      }
    },
    "beta": {
      "extends": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "play-beta": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6801581569"
      }
    },
    "production": {}
  }
}
